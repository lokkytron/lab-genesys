# =========================
# Docker-backed Services + Endpoints + Ingress (envsubst-ready)
# Change LAB_DOMAIN in your environment to update all hostnames
# =========================

# --- Gitea Service ---
apiVersion: v1
kind: Service
metadata:
  name: gitea-docker
  namespace: docker-services
spec:
  type: ClusterIP
  ports:
    - port: 3000
      targetPort: 3000
      protocol: TCP
---
# --- Gitea Endpoint ---
apiVersion: v1
kind: Endpoints
metadata:
  name: gitea-docker
  namespace: docker-services
subsets:
  - addresses:
      - ip: ${HOST_IP}
    ports:
      - port: 3000
---
# --- Gitea Ingress ---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: gitea-ingress
  namespace: docker-services
  annotations:
    cert-manager.io/cluster-issuer: smallstep-acme
    nginx.ingress.kubernetes.io/rewrite-target: /
    nginx.ingress.kubernetes.io/use-forwarded-headers: "true"
spec:
  ingressClassName: nginx
  tls:
    - hosts:
        - gitea.${LAB_DOMAIN}
      secretName: gitea-tls
  rules:
    - host: gitea.${LAB_DOMAIN}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: gitea-docker
                port:
                  number: 3000
---
